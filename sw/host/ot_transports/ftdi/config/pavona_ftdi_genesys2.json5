// top_wren on a Digilent Genesys 2, through the FT2232H on the USB PROG port.
// Channel A: ADBUS0-3 carry SPI to spi_device, ADBUS4-6 are the three
// software straps and ADBUS7 is the reset. Channel B stays free for JTAG.
//
// This does not include pavona.json5: Wren has no TAP strap pads (the chip
// file ties the TAP selection), no life cycle controller and no sysrst_ctrl,
// so only the reset, the software straps and the console are defined.
//
// The straps are active low at the board (the chip file inverts them, so the
// FTDI's idle pull-ups do not request bootstrap), hence `invert` here.
//
// The console is the board's FT232R (USB UART port). Numbered UARTs count the
// FT232R ports in enumeration order; with a second one attached (such as a
// PmodUSBUART), give the port path in a local configuration file instead:
//   { "uarts": [{ "name": "console", "alias_of": "/dev/serial/by-id/usb-FTDI_..." }] }
{
  "interface": "ftdi_genesys2",
  "pins": [
    {
      "name": "RESET",
      "mode": "PushPull",
      "level": true,
      "invert": false,
      "pull_mode": "None",
      "alias_of": "adbus7"
    },
    {
      "name": "SW_STRAP0",
      "mode": "PushPull",
      "level": false,
      "invert": true,
      "pull_mode": "None",
      "alias_of": "adbus4"
    },
    {
      "name": "SW_STRAP1",
      "mode": "PushPull",
      "level": false,
      "invert": true,
      "pull_mode": "None",
      "alias_of": "adbus5"
    },
    {
      "name": "SW_STRAP2",
      "mode": "PushPull",
      "level": false,
      "invert": true,
      "pull_mode": "None",
      "alias_of": "adbus6"
    }
  ],
  "strappings": [
    {
      "name": "ROM_BOOTSTRAP",
      "pins": [
        {
          "name": "SW_STRAP0",
          "level": true
        },
        {
          "name": "SW_STRAP1",
          "level": true
        },
        {
          "name": "SW_STRAP2",
          "level": true
        }
      ]
    },
    {
      "name": "RESET",
      "pins": [
        {
          "name": "RESET",
          "level": false
        }
      ]
    }
  ],
  "spi": [
    {
      "name": "BOOTSTRAP"
    }
  ],
  "uarts": [
    {
      "name": "console",
      "baudrate": 115200,
      "parity": "None",
      "stopbits": "Stop1",
      "alias_of": "0"
    }
  ],
  "provides": {
    "chip": "opentitan"
  }
}
