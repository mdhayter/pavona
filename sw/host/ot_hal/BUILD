load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_library", "rust_test")
load("//hw/top:defs.bzl", "ALL_TOPS")
load("//rules/pavona:hw.bzl", "get_top_attr", "has_top_attr")
load("//sw/host/ot_hal/bindgen:defs.bzl", "CROSS_CHECK_TOPS")

package(default_visibility = ["//visibility:public"])

# The host descriptions of all registered tops (their `host_desc` attribute), by top name.
HOST_DESCS = {
    top.name: get_top_attr(top, "host_desc")
    for top in ALL_TOPS
    if has_top_attr(top, "host_desc")
}

# The table of embedded descriptions that `top::desc` includes.
write_file(
    name = "embedded_host_descs",
    out = "src/top/embedded.rs",
    content = [
        "// Generated by //sw/host/ot_hal:embedded_host_descs from the tops' host_desc attributes.",
        "const EMBEDDED: &[(&str, &str)] = &[",
    ] + [
        "    (\"{0}\", include_str!(env!(\"top_{0}_host_desc\"))),".format(name)
        for name in sorted(HOST_DESCS)
    ] + [
        "];",
        "",
    ],
)

# The IP blocks whose registers host code uses that are not generated per top (not every such
# block, only the ones the host needs). Every top that has one uses its description in hw/ip
# (checked here when the package loads), so its register definitions are the same on every
# top. `dif::<ip>_regs` is generated by regtool from that description. Host code must take
# the registers of any other block from the top description.
FIXED_IPS = [
    "acc",
    "adc_ctrl",
    "aes",
    "aon_timer",
    "csrng",
    "edn",
    "entropy_src",
    "hmac",
    "i2c",
    "keymgr",
    "keymgr_dpe",
    "kmac",
    "lc_ctrl",
    "pattgen",
    "rv_timer",
    "spi_device",
    "spi_host",
    "sram_ctrl",
    "sysrst_ctrl",
    "uart",
    "usbdev",
]

[
    fail("Top {} takes IP {} from {}, not hw/ip; host code assumes hw/ip's registers".format(
        top.name,
        ip.name,
        ip.attrs.get("hjson"),
    ))
    for top in ALL_TOPS
    for ip in top.ips
    if ip.name in FIXED_IPS and ip.attrs.get("hjson") != "//hw/ip/{0}/data:{0}.hjson".format(ip.name)
]

[
    run_binary(
        name = "{}_regs".format(ip),
        srcs = ["//hw/ip/{0}/data:{0}.hjson".format(ip)],
        outs = ["src/dif/{}_regs.rs".format(ip)],
        args = [
            "--rust",
            "--outfile",
            "$(location :src/dif/{}_regs.rs)".format(ip),
            "$(location //hw/ip/{0}/data:{0}.hjson)".format(ip),
        ],
        tool = "//util:regtool",
    )
    for ip in FIXED_IPS
]

filegroup(
    name = "doc_files",
    srcs = glob(["**/*.md"]),
)

rust_library(
    name = "ot_hal",
    srcs = [
        "src/dif/aon_timer.rs",
        "src/dif/lc_ctrl.rs",
        "src/dif/mod.rs",
        "src/dif/otp_ctrl.rs",
        "src/dif/pinmux.rs",
        "src/dif/uart.rs",
        "src/lib.rs",
        # Compiled only by the `ot_hal_<top>_test`s; see `top::autogen`.
        "src/top/autogen/mod.rs",
        "src/top/desc.rs",
        "src/top/mod.rs",
        "src/util/alert.rs",
        "src/util/bitfield.rs",
        "src/util/mod.rs",
        "src/util/multibits.rs",
        "src/util/unknown.rs",
        ":embedded_host_descs",
    ] + [":{}_regs".format(ip) for ip in FIXED_IPS] + [
        "src/top/autogen/{}.rs".format(top)
        for top in CROSS_CHECK_TOPS
    ],
    # Embedded by `top::desc` whichever top is selected.
    compile_data = HOST_DESCS.values(),
    rustc_env = {
        "top_{}_host_desc".format(name): "$(location {})".format(label)
        for name, label in HOST_DESCS.items()
    },
    deps = [
        "//sw/host/ot_hal/bindgen",
        "@crate_index//:anyhow",
        "@crate_index//:bitflags",
        "@crate_index//:clap",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:strum",
        "@crate_index//:thiserror",
    ],
)

rust_test(
    name = "ot_hal_test",
    crate = ":ot_hal",
)

# For each top in CROSS_CHECK_TOPS, the tests again, plus the checks in `top::desc` of that top's
# description against its DIF and generated constants. The crate feature names the top.
[
    rust_test(
        name = "ot_hal_{}_test".format(top),
        crate = ":ot_hal",
        crate_features = [top],
        deps = [
            "//hw/top_{0}/sw/autogen/chip:top_{0}".format(top),
            "//sw/host/ot_hal/bindgen:top_dif_{}".format(top),
        ],
    )
    for top in CROSS_CHECK_TOPS
]

rust_doc(
    name = "ot_hal_doc",
    crate = ":ot_hal",
)
