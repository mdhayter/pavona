load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_library", "rust_test")
load("//hw/top:defs.bzl", "ALL_TOPS")
load("//rules/pavona:hw.bzl", "get_top_attr", "has_top_attr")

package(default_visibility = ["//visibility:public"])

# The host descriptions of all registered tops (their `host_desc` attribute), by top name.
HOST_DESCS = {
    top.name: get_top_attr(top, "host_desc")
    for top in ALL_TOPS
    if has_top_attr(top, "host_desc")
}

# The table of embedded descriptions that `top::desc` includes.
write_file(
    name = "embedded_host_descs",
    out = "src/top/embedded.rs",
    content = [
        "// Generated by //sw/host/ot_hal:embedded_host_descs from the tops' host_desc attributes.",
        "const EMBEDDED: &[(&str, &str)] = &[",
    ] + [
        "    (\"{0}\", include_str!(env!(\"top_{0}_host_desc\"))),".format(name)
        for name in sorted(HOST_DESCS)
    ] + [
        "];",
        "",
    ],
)

filegroup(
    name = "doc_files",
    srcs = glob(["**/*.md"]),
)

rust_library(
    name = "ot_hal",
    srcs = [
        "src/dif/aon_timer.rs",
        "src/dif/lc_ctrl.rs",
        "src/dif/mod.rs",
        "src/dif/otp_ctrl.rs",
        "src/dif/rstmgr.rs",
        "src/dif/uart.rs",
        "src/lib.rs",
        "src/top/autogen/mod.rs",
        "src/top/desc.rs",
        "src/top/mod.rs",
        "src/util/alert.rs",
        "src/util/bitfield.rs",
        "src/util/mod.rs",
        "src/util/multibits.rs",
        "src/util/unknown.rs",
        ":embedded_host_descs",
    ] + select({
        "//sw/device:is_scafi_deprecated": [],
        "//hw/top:egret": [
            "src/dif/clkmgr.rs",
            "src/dif/pinmux.rs",
            "src/top/autogen/egret.rs",
        ],
        "//hw/top:dragonfly": [
            "src/dif/clkmgr.rs",
            "src/dif/pinmux.rs",
            "src/top/autogen/dragonfly.rs",
        ],
    }),
    # Embedded by `top::desc` whichever top is selected.
    compile_data = HOST_DESCS.values(),
    crate_features = select({
        "//sw/device:is_scafi_deprecated": ["scafi_deprecated"],
        "//hw/top:egret": ["egret"],
        "//hw/top:dragonfly": ["dragonfly"],
    }),
    rustc_env = {
        "top_{}_host_desc".format(name): "$(location {})".format(label)
        for name, label in HOST_DESCS.items()
    },
    deps = [
        "//sw/host/ot_hal/bindgen",
        "@crate_index//:anyhow",
        "@crate_index//:bitflags",
        "@crate_index//:clap",
        "@crate_index//:serde",
        "@crate_index//:serde_json",
        "@crate_index//:strum",
        "@crate_index//:thiserror",
    ] + select({
        "//hw/top:egret": ["//hw/top_egret/sw/autogen/chip:top_egret"],
        "//hw/top:dragonfly": ["//hw/top_dragonfly/sw/autogen/chip:top_dragonfly"],
    }),
)

rust_test(
    name = "ot_hal_test",
    crate = ":ot_hal",
    # Not inherited from the crate; the top checks in `top::desc` need them.
    crate_features = select({
        "//sw/device:is_scafi_deprecated": ["scafi_deprecated"],
        "//hw/top:egret": ["egret"],
        "//hw/top:dragonfly": ["dragonfly"],
    }),
)

rust_doc(
    name = "ot_hal_doc",
    crate = ":ot_hal",
)
